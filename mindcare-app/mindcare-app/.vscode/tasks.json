{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Install All",
      "dependsOn": ["Backend: Install", "Frontend: Install"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Backend: Start",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "mindcare"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Start",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "mindcare"
      },
      "problemMatcher": []
    },
    {
      "label": "Run MindCare (Backend + Frontend)",
      "dependsOn": ["Backend: Start", "Frontend: Start"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
